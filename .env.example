APP_TITLE=Project File Share API
APP_DESCRIPTION=프로젝트 산출물 공유 시스템 초기 API
APP_VERSION=0.1.0
APP_ENV=production

DATABASE_URL=postgresql+psycopg://username:password@your-rds-endpoint:5432/file_share
UPLOAD_DIR=uploads
STORAGE_BACKEND=
USE_S3=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_REGION=
S3_PREFIX=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
PRESIGNED_URL_EXPIRES_IN=3600
AUTO_SEED_DATA=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
