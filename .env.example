APP_TITLE=Project File Share API
APP_DESCRIPTION=프로젝트 산출물 공유 시스템 초기 API
APP_VERSION=0.1.0
APP_ENV=production

DATABASE_URL=postgresql+psycopg://username:password@your-rds-endpoint:5432/file_share
UPLOAD_DIR=uploads
STORAGE_BACKEND=
USE_S3=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_REGION=
S3_PREFIX=uploads
# 공유 링크 URL 등 외부 노출용 API 베이스 (ALB/HTTPS 전환 후)
PUBLIC_BASE_URL=https://api.pagong.dev
PRESIGNED_URL_EXPIRES_IN=3600

# 프런트 도메인 (쉼표 구분, 끝 / 없이)
CORS_ORIGINS=https://pagong.dev,http://localhost:3000,http://localhost:3001

AUTO_SEED_DATA=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# 쿠키로 JWT를 내려줄 때만 사용 (현재 API는 Bearer 헤더). HTTPS에서는 true
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
