APP_TITLE=Project File Share API
APP_DESCRIPTION=프로젝트 산출물 공유 시스템 초기 API
APP_VERSION=0.1.0
APP_ENV=production

DATABASE_URL=postgresql+psycopg://username:password@your-rds-endpoint:5432/file_share
UPLOAD_DIR=uploads
AUTO_SEED_DATA=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
